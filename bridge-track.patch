+  # Bridge-track searches. Separate from `queries` because they need a commute
+  # radius, not a state: "New Jersey" returns Camden warehouse jobs. Adzuna
+  # measures `bridge_distance` in kilometres from `bridge_where`; 40 is about
+  # 25 miles, which covers Newark, Elizabeth, the Meadowlands, and Manhattan.
+  #
+  # The ATS sweep contributes almost nothing here (Greenhouse and Lever are
+  # startup boards), so Adzuna is the main pipe for this track. Keep the list
+  # short and rotate terms rather than adding ten more.
+  bridge_where: "Springfield, New Jersey"
+  bridge_distance: 40
+  bridge_max_days_old: 7
+  bridge_queries:
+    - "warehouse associate"
+    - "data entry clerk"
+    - "office clerk"
+    - "lab assistant"
+
+  # Quota: (5 queries + 4 bridge + 10 employers) x 2 runs/day x 22 weekdays =
+  # 836/month against a ~1,000 free tier. Four bridge terms is what fits. To
