+# ---------------------------------------------------------------------------
+# BRIDGE TRACK
+#
+# A second track for work that pays rent while the career search runs. It is
+# scored by a different rubric (score.BRIDGE_RUBRIC), against a different
+# question: not "does this match the record" but "can he get it, and can he
+# stand it". A degree is never a penalty there and never a qualification.
+#
+# The two tracks never mix in the digest. Bridge postings cannot push a
+# research job out of the top section and cannot be confused for one.
+#
+# Track assignment is title-only and free (score.classify_track):
+#   career title term hit           -> career, unchanged from before
+#   bridge title term hit           -> bridge
+#   bridge term + an `exclude` term -> dropped entirely, never scored
+#   neither                         -> career (status quo)
+# Career wins ties, so "Inventory Analyst" is still read as an analyst job.
+# ---------------------------------------------------------------------------
+bridge:
+  enabled: true
+
+  # Contact you will put up with, even though the words below would otherwise
+  # drop it. `tolerated` beats `exclude` and is an include term in its own
+  # right, so "Barista" reaches the scorer while "Barista/Server" no longer
+  # has to be argued about: barista wins, and the rubric reads the duties.
+  #
+  # The rubric sorts contact into three kinds, and this list is about the
+  # middle one: a queue and a task, over in forty seconds, nobody's mood
+  # becomes your problem. Adjacent candidates if you want them, roughly in
+  # order of how close they are to what is already here:
+  #
+  #   - counter, "counter attendant"     deli, bakery, kiosk
+  #   - "circulation"                    library desk, extremely quiet
+  #   - "pharmacy technician"            fill counter, but state licensure
+  #   - cashier, "front end"             retail, which you said no to
+  #   - "front desk", receptionist       transactional but you are the lobby
+  #
+  # Anything you add here still gets read and scored; it is not a promotion,
+  # only permission for the model to consider it.
+  tolerated:
+    - barista
+    - "coffee"
+    - "cafe"
+    - "café"
+    - "espresso"
+    - "roaster"
+
+  # The actual no: relational service, phones, selling. Dropped before it
+  # costs a model call. Only applied to titles that already matched a bridge
+  # term, so "Server Engineer" and "Sales Operations Analyst" are unaffected
+  # on the career track.
+  exclude:
+    # Retail floor
+    - cashier
+    - retail
+    - "sales associate"
+    - "sales floor"
+    - "store associate"
+    - "front end"
+    - greeter
+    - merchandiser
+    - "brand ambassador"
+    # Restaurant
+    - server
+    - waiter
+    - waitress
+    - barista
+    - bartender
+    - barback
+    - busser
+    - hostess
+    - "line cook"
+    - "prep cook"
+    - dishwasher
+    - "food service"
+    - "food runner"
+    - catering
+    - "crew member"
+    - "team member"
+    # Phones and the public generally
+    - "customer service"
+    - "customer support"
+    - "customer experience"
+    - "call center"
+    - "contact center"
+    - "guest service"
