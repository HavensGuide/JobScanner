+      if (stop) stop.onclick = () => api(`runs/${id}/stop`, { method: "POST" }).then(() => toast("Stopping")).catch(fail);
+      if (r.running) timer = setTimeout(pump, 700);
+      else if (onDone) onDone(r);
+    } catch (e) { pre.textContent = e.message; }
+  }
+  return {
+    async run(kind, options) {
+      clearTimeout(timer); lines = []; next = 0;
+      pre.textContent = "Starting";
+      try {
+        const r = await Tasks.start(kind, options, { quietToast: true });
+        id = r.id; pump();
+      } catch (e) { pre.innerHTML = `<span class="bad">${esc(e.message)}</span>`; }
+    },
+    attach(runId) { clearTimeout(timer); id = runId; lines = []; next = 0; pump(); },
+  };
