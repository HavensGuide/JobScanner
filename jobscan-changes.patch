+  const head = document.createElement("div"); head.className = "log-head";
+  const pre = document.createElement("pre"); pre.className = "log";
+  pre.textContent = "Output appears here.";
+  container.append(head, pre);
+  async function pump() {
+    if (!id) return;
+    try {
+      const r = await api(`runs/${id}?since=${next}`);
+      lines = lines.concat(r.lines); next = r.next;
+      const atBottom = pre.scrollHeight - pre.scrollTop - pre.clientHeight < 40;
+      pre.innerHTML = logHtml(lines) || "Waiting for output";
+      if (atBottom) pre.scrollTop = pre.scrollHeight;
+      head.innerHTML = `<code>${esc(r.command)}</code>` + (r.running
+        ? `<span class="row" style="align-items:center"><span class="status-dot"><span class="spin"></span>Running</span><button class="btn danger" data-stop>Stop</button></span>`
+        : `<span class="status-dot ${r.code === 0 ? "ok" : "fail"}">${r.code === 0 ? "Finished" : `Exited with code ${r.code}`}</span>`);
