+        ${["career", "bridge"].map((t) => `<tr><td>${t === "career" ? "Career" : "Bridge"}</td><td>${methodSel(t)}</td>
+          <td>${sel("jev", t, false)}</td><td>${sel("rubric", t, true)}</td></tr>`).join("")}</table></div>
+      <div class="section"><h2>Tailoring</h2>
+        <table class="plain" style="margin-top:8px"><tr><th>Step</th><th>Model</th><th></th></tr>
+        ${["tailor_analyze", "tailor_letter", "tailor_resume"].map((r) => `<tr><td>${ROLE_WORD[r]}</td><td>${sel(r, null, true)}</td>
+          <td class="hint">${r === "tailor_analyze" ? "Once per posting you tailor" : "Only for postings the analysis says to apply to"}</td></tr>`).join("")}</table></div>
+      <div class="section"><h2>Profiles</h2>
+        <p class="hint">Add or change a profile in <a href="#/settings/models">Settings</a>, under models:.</p>
+        <table class="plain" style="margin-top:8px"><tr><th>Name</th><th>Provider and model</th><th>Where</th><th>Cost</th></tr>
+        ${m.profiles.map((p) => `<tr><td><b>${esc(p.name)}</b></td><td>${esc(p.provider || "")}${p.model ? `, ${esc(p.model)}` : ""}
+          ${p.problem ? `<div class="problem">${esc(p.problem)}</div>` : ""}</td><td class="hint">${esc(p.where || "")}</td>
+          <td>${p.cost === "free" ? "Free" : "Paid"}</td></tr>`).join("")}</table></div>`;
+    $$("select[data-role]").forEach((s) => s.onchange = async () => {
+      try {
+        const nm = await api("models/role", { method: "POST", body: { role: s.dataset.role, track: s.dataset.track || null, profile: s.value } });
+        toast(`${ROLE_WORD[s.dataset.role]}${s.dataset.track ? ` (${s.dataset.track})` : ""} now uses ${s.value}`);
+        this.draw(nm); refreshSide();
+      } catch (e) { fail(e); this.draw(m); }
+    });
+    $$("select[data-method]").forEach((s) => s.onchange = async () => {
+      try {
+        const nm = await api("models/method", { method: "POST", body: { track: s.dataset.method, method: s.value } });
+        toast(`${s.dataset.method === "career" ? "Career" : "Bridge"} postings are now scored by ${s.value}`);
+        this.draw(nm); refreshSide();
+      } catch (e) { fail(e); this.draw(m); }
+    });
+  },
+};
+Router.pages.models = Models;
+
+/* =======================================================================
+   Settings and Resume: one editor, two files
+   ======================================================================= */
+function Editor(which, title, lede) {
+  return {
+    async render(root, [jump]) {
+      root.innerHTML = `<div class="page"><div class="page-head"><h1>${title}</h1>
+        <button class="btn" id="e-check">Check</button><button class="btn primary" id="e-save">Save</button>
+        <span class="muted" id="e-state"></span></div>
+        <p class="lede">${lede}</p>
+        <div class="editor"><nav class="outline" id="e-outline" aria-label="Sections"></nav>
+        <div><textarea class="code" id="e-text" spellcheck="false" aria-label="${esc(title)}"></textarea><ul class="msgs" id="e-msgs"></ul></div></div></div>`;
+      const ta = $("#e-text");
+      let saved = "";
+      try { const d = await api(`config/${which}`); ta.value = saved = d.text; } catch (e) { return fail(e); }
+      const fit = () => { ta.style.height = "auto"; ta.style.height = Math.max(400, Math.min(ta.scrollHeight + 4, innerHeight * 0.78)) + "px"; };
+      fit();
+      const outline = () => {
+        const lines = ta.value.split("\n");
+        $("#e-outline").innerHTML = lines.map((l, i) => /^[A-Za-z_][\w-]*:/.test(l) ? `<button data-line="${i}">${esc(l.split(":")[0])}</button>` : "").join("");
+        $$("#e-outline button").forEach((b) => b.onclick = () => this.jumpTo(+b.dataset.line));
+      };
+      outline();
+      const dirty = () => { $("#e-state").textContent = ta.value !== saved ? "Unsaved changes" : ""; };
+      ta.oninput = () => { dirty(); clearTimeout(this.t); this.t = setTimeout(outline, 400); };
+      ta.onkeydown = (e) => {
+        if (e.key === "Tab") { e.preventDefault(); const s = ta.selectionStart; ta.setRangeText("  ", s, ta.selectionEnd, "end"); dirty(); }
+        if ((e.ctrlKey || e.metaKey) && e.key === "s") { e.preventDefault(); save(); }
+      };
+      const show = (d) => {
+        $("#e-msgs").innerHTML = [...(d.errors || []).map((m) => `<li class="e">${esc(m)}</li>`), ...(d.warnings || []).map((m) => `<li class="w">${esc(m)}</li>`)].join("");
+      };
+      const check = async () => {
+        const r = await api(`config/${which}`, { method: "PUT", body: { text: ta.value, check_only: true }, allowError: true });
+        show(r.data);
+        if (r.ok) toast(r.data.warnings?.length ? "Valid, with warnings below" : "No problems found");
+      };
+      const save = async () => {
+        const r = await api(`config/${which}`, { method: "PUT", body: { text: ta.value }, allowError: true });
+        show(r.data);
+        if (!r.ok) return toast("Not saved. Fix the errors below first.", { bad: true });
+        saved = ta.value; dirty(); App.models = null; refreshSide();
+        toast(r.data.backup ? `Saved. The previous version is in backups/${r.data.backup}` : "Saved");
+      };
+      $("#e-check").onclick = check; $("#e-save").onclick = save;
+      window.onbeforeunload = () => (ta.value !== saved ? true : undefined);
+      if (jump) {
+        const i = ta.value.split("\n").findIndex((l) => l.startsWith(jump + ":"));
+        if (i >= 0) setTimeout(() => this.jumpTo(i), 50);
+      }
+    },
+    jumpTo(line) {
+      const ta = $("#e-text");
+      const lines = ta.value.split("\n");
+      const pos = lines.slice(0, line).reduce((a, l) => a + l.length + 1, 0);
+      ta.focus(); ta.setSelectionRange(pos, pos + lines[line].length);
+      const lh = parseFloat(getComputedStyle(ta).lineHeight) || 20;
+      ta.scrollTop = Math.max(0, line * lh - 60);
+    },
+  };
+}
+Router.pages.settings = Editor("config", "Settings",
+  "Everything jobscan does is configured here: sources, filters, both tracks, the jev questions, the rubrics and the models. Check validates it the way a run would; Save keeps a backup of the old file.");
+Router.pages.resume = Editor("resume", "Resume facts",
+  "The scorer and the letter writer may only use facts from this file. If a skill is here that you do not have, the letters will claim it.");
+
+/* =======================================================================
+   Health
+   ======================================================================= */
+const Health = {
+  async render(root) {
+    root.innerHTML = `<div class="page"><div class="page-head"><h1>Health</h1></div>
+      <div class="section"><div class="section-grid">
+        <div class="stack"><h2>Preflight</h2><p class="hint">Checks the config, the resume file, every credential and every model, and pokes each job source once. Costs one Adzuna and one USAJOBS call.</p>
+          <label class="check"><input type="checkbox" id="h-probe"> Also send one tiny request to each model</label>
+          <div><button class="btn primary" id="h-go">Run preflight</button></div>
+          <h3 style="margin-top:12px">Keys and passwords</h3><p class="hint">Read from .env. Values are never shown here.</p><div id="h-env"></div></div>
+        <div id="h-log"></div></div></div>
+      <div class="section"><div class="section-grid">
+        <div class="stack"><h2>Company job boards</h2><p class="hint">The sweep checks every Greenhouse, Lever and Ashby board in a public list. Refresh it now and then; find the board names for specific employers to add them by hand.</p>
+          <div><button class="btn" id="s-refresh">Refresh the board list</button></div>
+          <label class="field">Find boards for these employers<input type="text" id="s-find" placeholder="Urban Institute, RAND Corporation"></label>
+          <div><button class="btn primary" id="s-go">Find</button></div></div>
+        <div id="s-log"></div></div></div></div>`;
+    const h = inlineRunner($("#h-log")), s = inlineRunner($("#s-log"));
+    $("#h-go").onclick = () => h.run("preflight", { probe: $("#h-probe").checked });
+    $("#s-refresh").onclick = () => s.run("slugs", {});
+    $("#s-go").onclick = () => s.run("slugs", { find: $("#s-find").value });
+    try {
+      const env = await api("env");
+      $("#h-env").innerHTML = `<table class="plain">${env.map((e) => `<tr><td><code>${esc(e.key)}</code></td><td class="hint">${esc(e.for)}</td>
+        <td style="white-space:nowrap">${e.set ? '<span class="t-strong">Set</span>' : '<span class="muted">Not set</span>'}</td></tr>`).join("")}</table>`;
+    } catch (e) { fail(e); }
+  },
+};
+Router.pages.health = Health;
+
+/* ---- boot ------------------------------------------------------------- */
+(async function boot() {
+  await refreshSide();
+  api("drafts").then((d) => { $("#nav-drafts").textContent = d.length || ""; }).catch(() => {});
+  Router.render();
+  Tasks.tick();
+  setInterval(refreshSide, 60000);
+})();
+
+</script>
+</body>
+</html>
