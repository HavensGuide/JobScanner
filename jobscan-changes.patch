+  animation: spin 0.8s linear infinite;
+}
+@keyframes spin { to { transform: rotate(360deg); } }
+@media (prefers-reduced-motion: reduce) { .spin { animation: none; border-right-color: var(--accent); opacity: .6; } }
+
+main { overflow-y: auto; min-width: 0; }
+.page { padding: 22px 28px 40px; max-width: 1480px; }
+.page-head { display: flex; align-items: baseline; gap: 18px; flex-wrap: wrap; margin-bottom: 16px; }
+h1 { font: 600 24px/1.2 var(--sans); letter-spacing: -0.015em; margin: 0; }
+h2 { font: 600 17px/1.3 var(--sans); margin: 0 0 4px; }
+h3 { font: 600 15px/1.3 var(--sans); margin: 0 0 6px; }
+.lede { color: var(--muted); margin: 2px 0 14px; max-width: 70ch; }
+
+/* ---------------------------------------------------------------------
+   Controls
+   --------------------------------------------------------------------- */
+.btn {
+  display: inline-flex; align-items: center; gap: 7px;
+  border: 1px solid var(--line); background: var(--raised);
+  padding: 6px 12px; border-radius: var(--r-small); cursor: pointer;
+  font-weight: 500; white-space: nowrap; text-decoration: none; color: var(--ink);
+}
+.btn:hover { border-color: var(--muted); }
+.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
+.btn.primary:hover { filter: brightness(1.08); }
+.btn.quiet { background: transparent; border-color: transparent; color: var(--accent); padding-left: 6px; padding-right: 6px; }
+.btn.quiet:hover { background: var(--accent-soft); }
+.btn.danger { color: var(--danger); }
+.btn:disabled { opacity: .5; cursor: default; }
+.seg { display: inline-flex; border: 1px solid var(--line); border-radius: var(--r-small); background: var(--raised); overflow: hidden; }
+.seg button { border: 0; background: transparent; padding: 5px 12px; cursor: pointer; font-weight: 500; color: var(--muted); }
+.seg button + button { border-left: 1px solid var(--line); }
+.seg button[aria-pressed="true"] { background: var(--ink); color: var(--raised); }
+input[type=text], input[type=number], input[type=search], select, textarea {
+  border: 1px solid var(--line); background: var(--raised); border-radius: var(--r-small);
+  padding: 6px 9px; min-width: 0;
+}
+input:focus, select:focus, textarea:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px var(--accent-soft); }
+label.field { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--muted); font-weight: 500; }
+label.field > input, label.field > select, label.field > textarea { color: var(--ink); font-weight: 400; font-size: 15px; }
+label.check { display: inline-flex; gap: 7px; align-items: center; cursor: pointer; }
+.row { display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; }
+.stack { display: flex; flex-direction: column; gap: 12px; }
+.hint { font-size: 13px; color: var(--muted); max-width: 72ch; }
+
+/* tier language */
+.t-strong { color: var(--strong); } .t-review { color: var(--review); }
+.t-maybe { color: var(--maybe); } .t-weak { color: var(--weak); } .t-unscored { color: var(--unscored); }
+.tierword { font-weight: 600; }
+
+/* ---------------------------------------------------------------------
+   Postings: the score strip is the one loud thing in the product
+   --------------------------------------------------------------------- */
+.strip-wrap { background: var(--raised); border: 1px solid var(--line); border-radius: var(--r); padding: 14px 18px 12px; margin-bottom: 14px; }
+.strip-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
+.strip-top .zones { display: flex; gap: 18px; font-size: 14px; flex-wrap: wrap; }
+.strip-top .zones b { font-variant-numeric: tabular-nums; }
+.strip { position: relative; height: 92px; user-select: none; touch-action: none; }
+.strip svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; overflow: visible; }
+.handle {
+  position: absolute; top: -4px; bottom: 16px; width: 22px; margin-left: -11px;
+  cursor: ew-resize; display: flex; justify-content: center; z-index: 2;
+}
+.handle::before { content: ""; width: 2px; background: var(--ink); border-radius: 1px; }
+.handle span {
+  position: absolute; top: -2px; left: 13px; white-space: nowrap;
+  font: 600 12.5px/1 var(--sans); background: var(--ink); color: var(--raised);
+  padding: 4px 6px; border-radius: 3px; font-variant-numeric: tabular-nums;
+}
+.handle.maybe span { left: auto; right: 13px; }
+.handle:focus-visible { outline: none; }
+.handle:focus-visible::before { width: 4px; background: var(--accent); }
+.strip-axis { position: absolute; left: 0; right: 0; bottom: 0; height: 14px; font-size: 11.5px; color: var(--faint); }
+.strip-axis span { position: absolute; transform: translateX(-50%); font-variant-numeric: tabular-nums; }
+.strip-actions { display: flex; gap: 8px; align-items: center; }
+
+.filters { display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: center; margin-bottom: 12px; }
+.chips { display: flex; flex-wrap: wrap; gap: 4px; }
+.chip {
+  border: 1px solid var(--line); background: var(--raised); border-radius: 999px;
+  padding: 3px 11px 3px 10px; cursor: pointer; font-weight: 500; font-size: 14px;
+  display: inline-flex; gap: 6px; align-items: baseline;
+}
+.chip .n { color: var(--muted); font-weight: 400; font-variant-numeric: tabular-nums; }
+.chip[aria-pressed="true"] { border-color: currentColor; box-shadow: inset 0 0 0 1px currentColor; }
+.filters .grow { flex: 1 1 200px; min-width: 160px; }
+
+.split { display: grid; grid-template-columns: minmax(330px, 42%) 1fr; gap: 14px; align-items: start; }
+.list { background: var(--raised); border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; }
+.list-head { display: flex; justify-content: space-between; padding: 8px 14px; border-bottom: 1px solid var(--line-soft); font-size: 13px; color: var(--muted); }
+.jobrow {
+  display: grid; grid-template-columns: 44px 1fr auto; gap: 2px 10px;
+  padding: 10px 14px 10px 12px; border-bottom: 1px solid var(--line-soft);
+  cursor: pointer; text-align: left; width: 100%; border-left: 3px solid transparent;
+  background: none; border-top: 0; border-right: 0;
+}
+.jobrow:hover { background: var(--surface); }
+.jobrow[aria-selected="true"] { background: var(--accent-soft); border-left-color: var(--accent); }
+.jobrow .sc { grid-row: span 2; font: 600 21px/1.1 var(--sans); font-variant-numeric: tabular-nums; padding-top: 1px; }
+.jobrow .ti { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.jobrow .co { color: var(--muted); font-size: 13.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.jobrow .side-r { grid-row: span 2; text-align: right; font-size: 12.5px; color: var(--muted); display: flex; flex-direction: column; gap: 2px; align-items: flex-end; }
+.jobrow.dim .ti, .jobrow.dim .co { opacity: .55; }
+.pill { font-size: 12px; padding: 0 7px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); white-space: nowrap; line-height: 18px; }
+.pill.applied { color: var(--strong); border-color: currentColor; }
+.pill.saved { color: var(--accent); border-color: currentColor; }
+.pill.drafted { color: var(--review); border-color: currentColor; }
+.more { padding: 12px; text-align: center; }
+
+.detail { background: var(--raised); border: 1px solid var(--line); border-radius: var(--r); padding: 22px 26px 30px; position: sticky; top: 14px; max-height: calc(100vh - 28px); overflow-y: auto; }
+.detail .empty { color: var(--muted); padding: 40px 0; text-align: center; }
+.d-title { font: 500 27px/1.18 var(--serif); letter-spacing: -0.01em; margin: 0 0 6px; }
+.d-meta { color: var(--muted); display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 14px; }
+.verdict { display: grid; grid-template-columns: auto 1fr; gap: 4px 18px; align-items: center; margin: 18px 0; padding: 14px 0; border-top: 1px solid var(--line-soft); border-bottom: 1px solid var(--line-soft); }
+.verdict .big { font: 600 46px/1 var(--sans); font-variant-numeric: tabular-nums; grid-row: span 2; letter-spacing: -0.02em; }
+.verdict .why { font-size: 16px; }
+.verdict .who { font-size: 13px; color: var(--muted); }
+.actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 8px; }
+.posting { font: 400 17.5px/1.62 var(--serif); max-width: 68ch; margin-top: 20px; white-space: pre-wrap; overflow-wrap: anywhere; }
+.posting.thin { color: var(--muted); font-style: italic; }
+.drafts-inline { margin-top: 10px; font-size: 14px; }
+.back { display: none; }
+
+/* ---------------------------------------------------------------------
+   Logs, toasts, sections
+   --------------------------------------------------------------------- */
+.log {
+  background: var(--log-bg); color: var(--log-ink); border-radius: var(--r);
+  font: 12.5px/1.55 var(--mono); padding: 12px 14px; overflow: auto;
+  white-space: pre-wrap; overflow-wrap: anywhere; min-height: 120px; max-height: 60vh;
+}
+.log .bad { color: #FF9C94; } .log .warn { color: #F2C66D; } .log .good { color: #7FD7A8; }
+.log-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin: 0 0 8px; flex-wrap: wrap; }
+.log-head code { font: 12.5px var(--mono); color: var(--muted); overflow-wrap: anywhere; }
+.status-dot { display: inline-flex; gap: 6px; align-items: center; font-weight: 600; font-size: 14px; }
+.status-dot.ok { color: var(--ok); } .status-dot.fail { color: var(--danger); }
+
+.section { padding: 20px 0 22px; border-top: 1px solid var(--line); }
+.section:first-of-type { border-top: 0; padding-top: 4px; }
+.section-grid { display: grid; grid-template-columns: minmax(280px, 380px) 1fr; gap: 24px; align-items: start; }
+.panel { background: var(--raised); border: 1px solid var(--line); border-radius: var(--r); padding: 16px 18px; }
+
+.toasts { position: fixed; right: 18px; bottom: 18px; display: flex; flex-direction: column; gap: 8px; z-index: 50; max-width: min(420px, calc(100vw - 36px)); }
+.toast { background: var(--ink); color: var(--raised); border-radius: var(--r); padding: 11px 14px; display: flex; gap: 12px; align-items: center; box-shadow: 0 6px 24px rgba(10,20,30,.22); }
+.toast .btn.quiet { color: inherit; text-decoration: underline; }
+.toast.bad { background: var(--danger); color: #fff; }
+.toast .msg { flex: 1; }
+
+table.plain { border-collapse: collapse; width: 100%; font-size: 14px; }
+table.plain th { text-align: left; font-weight: 600; color: var(--muted); font-size: 13px; padding: 6px 10px 6px 0; border-bottom: 1px solid var(--line); }
+table.plain td { padding: 8px 10px 8px 0; border-bottom: 1px solid var(--line-soft); vertical-align: top; }
+.problem { color: var(--danger); font-size: 13px; }
+
+/* drafts */
+.drafts { display: grid; grid-template-columns: minmax(280px, 34%) 1fr; gap: 14px; align-items: start; }
+.draftrow { display: block; width: 100%; text-align: left; border: 0; border-bottom: 1px solid var(--line-soft); background: none; padding: 10px 14px; cursor: pointer; border-left: 3px solid transparent; }
+.draftrow:hover { background: var(--surface); }
+.draftrow[aria-selected="true"] { background: var(--accent-soft); border-left-color: var(--accent); }
+.draftrow .ti { font-weight: 600; } .draftrow .co { color: var(--muted); font-size: 13.5px; }
+.rec-apply { color: var(--strong); } .rec-manual_review { color: var(--review); } .rec-do_not_apply { color: var(--danger); }
+.tabs { display: flex; gap: 2px; border-bottom: 1px solid var(--line); margin-bottom: 16px; }
+.tabs button { border: 0; background: none; padding: 8px 12px; cursor: pointer; font-weight: 500; color: var(--muted); border-bottom: 2px solid transparent; margin-bottom: -1px; }
+.tabs button[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--ink); }
+textarea.letter { width: 100%; min-height: 420px; font: 400 17px/1.6 var(--serif); padding: 16px 18px; resize: vertical; }
+textarea.code { width: 100%; font: 13px/1.6 var(--mono); padding: 12px 14px; resize: vertical; tab-size: 2; white-space: pre; }
+
+/* settings editor */
+.editor { display: grid; grid-template-columns: 190px 1fr; gap: 14px; align-items: start; }
+.outline { position: sticky; top: 14px; display: flex; flex-direction: column; font-size: 14px; max-height: calc(100vh - 120px); overflow-y: auto; }
+.outline button { text-align: left; background: none; border: 0; padding: 4px 8px; cursor: pointer; border-radius: var(--r-small); color: var(--ink); }
+.outline button:hover { background: var(--line-soft); }
+.msgs { margin: 10px 0 0; padding: 0; list-style: none; font-size: 14px; }
+.msgs li { padding: 6px 10px; border-radius: var(--r-small); margin-bottom: 4px; }
+.msgs .e { background: color-mix(in srgb, var(--danger) 12%, transparent); color: var(--danger); }
+.msgs .w { background: color-mix(in srgb, var(--maybe) 14%, transparent); color: var(--maybe); }
+
+iframe.digest { width: 100%; height: 70vh; border: 1px solid var(--line); border-radius: var(--r); background: #fff; }
+
+/* ---------------------------------------------------------------------
+   Narrow screens: sidebar becomes a top bar, list and detail stack
+   --------------------------------------------------------------------- */
+@media (max-width: 920px) {
+  .app { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
+  .side { flex-direction: row; align-items: center; border-right: 0; border-bottom: 1px solid var(--line); padding: 10px 12px; gap: 12px; overflow-x: auto; }
+  .mark { font-size: 22px; } .mark small, .side-foot { display: none; }
+  nav { flex-direction: row; }
+  nav a { white-space: nowrap; }
+  .list-head .faint { display: none; }
+  nav a .count { display: none; }
+  .page { padding: 16px 14px 32px; }
+  .split, .drafts, .section-grid, .editor { grid-template-columns: 1fr; }
+  .outline { display: none; }
+  .split.show-detail .list, .drafts.show-detail .list { display: none; }
+  .split:not(.show-detail) .detail { display: none; }
+  .detail { position: static; max-height: none; padding: 18px; }
+  .back { display: inline-flex; margin-bottom: 10px; }
+  .verdict .big { font-size: 38px; }
+}
+</style>
+</head>
+<body>
+<div class="app">
+  <aside class="side">
+    <p class="mark">jobscan<small id="side-sub">Loading</small></p>
+    <nav id="nav" aria-label="Sections">
+      <a href="#/postings" data-page="postings">Postings <span class="count" id="nav-postings"></span></a>
+      <a href="#/run" data-page="run">Run a scan</a>
+      <a href="#/drafts" data-page="drafts">Drafts <span class="count" id="nav-drafts"></span></a>
+      <a href="#/scoring" data-page="scoring">Scoring</a>
+      <a href="#/models" data-page="models">Models</a>
+      <a href="#/settings" data-page="settings">Settings</a>
+      <a href="#/resume" data-page="resume">Resume facts</a>
+      <a href="#/health" data-page="health">Health</a>
+    </nav>
+    <div class="side-foot">
+      <p id="side-last"></p>
+      <div class="tasks-mini" id="tasks-mini"></div>
+    </div>
+  </aside>
+  <main id="main" tabindex="-1"></main>
+</div>
+<div class="toasts" id="toasts" role="status" aria-live="polite"></div>
+<script>
+"use strict";
+/* =======================================================================
+   Core
+   ======================================================================= */
+const $ = (s, el = document) => el.querySelector(s);
+const $$ = (s, el = document) => [...el.querySelectorAll(s)];
+const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) =>
+  ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
+const TIERS = ["strong", "review", "maybe", "weak", "unscored"];
+const TIER_WORD = {
+  career: { strong: "Strong", review: "Review", maybe: "Maybe", weak: "Weak", unscored: "Unscored" },
+  bridge: { strong: "Good fit", review: "Review", maybe: "Maybe", weak: "Poor fit", unscored: "Unscored" },
+};
+const STATUS_WORD = { new: "New", saved: "Saved", applied: "Applied", dismissed: "Dismissed" };
+
+async function api(path, opts = {}) {
+  const init = { method: opts.method || "GET", headers: {} };
+  if (init.method !== "GET") {
+    init.headers["X-Jobscan"] = "1";
+    init.headers["Content-Type"] = "application/json";
+    init.body = JSON.stringify(opts.body || {});
+  }
+  const res = await fetch("/api/" + path, init);
+  let data;
+  try { data = await res.json(); } catch { data = {}; }
+  if (!res.ok && !opts.allowError) throw new Error(data.error || `Request failed (${res.status})`);
+  return opts.allowError ? { ok: res.ok, data } : data;
+}
+const qs = (o) => Object.entries(o).filter(([, v]) => v !== "" && v != null && v !== false)
+  .map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join("&");
+
+function ago(iso) {
+  if (!iso) return "";
+  const s = (Date.now() - new Date(iso).getTime()) / 1000;
+  if (s < 90) return "just now";
+  if (s < 3600) return `${Math.round(s / 60)} min ago`;
+  if (s < 86400) return `${Math.round(s / 3600)} h ago`;
+  const d = Math.round(s / 86400);
+  return d === 1 ? "yesterday" : `${d} days ago`;
+}
+function shortAgo(iso) {
+  if (!iso) return "";
+  const s = (Date.now() - new Date(iso).getTime()) / 1000;
+  if (s < 3600) return `${Math.max(1, Math.round(s / 60))}m`;
+  if (s < 86400) return `${Math.round(s / 3600)}h`;
+  return `${Math.round(s / 86400)}d`;
+}
+
+/* ---- toasts ---------------------------------------------------------- */
+function toast(msg, { bad = false, action = null, ms = 4200 } = {}) {
+  const el = document.createElement("div");
+  el.className = "toast" + (bad ? " bad" : "");
+  el.innerHTML = `<span class="msg">${esc(msg)}</span>`;
+  if (action) {
+    const b = document.createElement("button");
+    b.className = "btn quiet"; b.textContent = action.label;
+    b.onclick = () => { action.run(); el.remove(); };
+    el.appendChild(b);
+  }
+  const x = document.createElement("button");
+  x.className = "btn quiet"; x.setAttribute("aria-label", "Dismiss"); x.textContent = "Close";
+  x.onclick = () => el.remove();
+  el.appendChild(x);
+  $("#toasts").appendChild(el);
+  if (ms) setTimeout(() => el.remove(), ms);
+}
+const fail = (e) => toast(e.message || String(e), { bad: true, ms: 8000 });
+
+/* ---- tasks: every script run, polled while anything is running --------- */
+const Tasks = {
+  known: new Map(), watchers: new Map(), timer: null,
+  async start(kind, options, { onDone, quietToast } = {}) {
+    const run = await api("runs", { method: "POST", body: { kind, options } });
+    this.known.set(run.id, run);
+    if (onDone) this.watchers.set(run.id, onDone);
+    if (!quietToast) toast(`Started: ${run.label}`, { action: { label: "View log", run: () => go(`#/run/${run.id}`) } });
+    this.poll();
+    return run;
+  },
+  poll() { clearTimeout(this.timer); this.timer = setTimeout(() => this.tick(), 900); },
+  async tick() {
+    let runs = [];
+    try { runs = await api("runs"); } catch { return this.poll(); }
+    for (const r of runs) {
+      const before = this.known.get(r.id);
+      if (before && before.running && !r.running) this.finished(r);
+      this.known.set(r.id, r);
+    }
+    renderTasksMini(runs);
+    if (Router.page === "run") RunPage.refreshList(runs);
+    if (runs.some((r) => r.running)) this.poll();
+  },
+  finished(r) {
+    const cb = this.watchers.get(r.id);
+    this.watchers.delete(r.id);
+    const ok = r.code === 0;
+    toast(`${ok ? "Finished" : "Failed"}: ${r.label}`, {
+      bad: !ok, ms: ok ? 5000 : 10000,
+      action: { label: "View log", run: () => go(`#/run/${r.id}`) },
+    });
+    if (cb) cb(r);
+    refreshSide();
+  },
+};
+function renderTasksMini(runs) {
+  const live = runs.filter((r) => r.running);
+  $("#tasks-mini").innerHTML = live.map((r) =>
+    `<a href="#/run/${r.id}"><span class="spin" aria-hidden="true"></span>${esc(r.label)}</a>`).join("");
+}
+
+/* ---- sidebar --------------------------------------------------------- */
+async function refreshSide() {
+  try {
+    const s = await api("summary");
+    App.summary = s;
+    $("#side-sub").textContent = `${s.total.toLocaleString()} postings stored`;
+    $("#side-last").textContent = s.last_run
+      ? `Last scan ${ago(s.last_run)}, ${s.last_run_count} new` : "No scans yet";
+    $("#nav-postings").textContent = s.total ? s.total.toLocaleString() : "";
+  } catch (e) { $("#side-sub").textContent = "Server not answering"; }
+}
+
+/* ---- router ---------------------------------------------------------- */
+const App = { summary: null, models: null };
+const go = (hash) => { if (location.hash === hash) Router.render(); else location.hash = hash; };
+const Router = {
+  page: null,
+  pages: {},
+  render() {
+    const [, page = "postings", ...rest] = location.hash.split("/");
+    const name = this.pages[page] ? page : "postings";
+    this.page = name;
+    $$("#nav a").forEach((a) => { if (a.dataset.page !== name) a.removeAttribute("aria-current"); else a.setAttribute("aria-current", "page"); });
+    const main = $("#main");
+    main.innerHTML = "";
+    main.scrollTop = 0;
+    this.pages[name].render(main, rest.map(decodeURIComponent));
+  },
+};
+window.addEventListener("hashchange", () => Router.render());
+
+/* ---- small builders -------------------------------------------------- */
+function seg(options, value, onChange, label) {
+  const el = document.createElement("div");
+  el.className = "seg"; el.setAttribute("role", "group");
+  if (label) el.setAttribute("aria-label", label);
+  for (const [v, text] of options) {
+    const b = document.createElement("button");
+    b.type = "button"; b.textContent = text; b.dataset.v = v;
+    b.setAttribute("aria-pressed", String(v === value));
+    b.onclick = () => {
+      $$("button", el).forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
+      onChange(v);
+    };
+    el.appendChild(b);
+  }
+  return el;
+}
+function logHtml(lines) {
+  return lines.map((l) => {
+    const e = esc(l);
+    if (/^\s*(\[ FAIL \]|!!|Traceback|error:|\s*! )/.test(l) || /Error:/.test(l)) return `<span class="bad">${e}</span>`;
+    if (/^\s*(\[ warn \]|  ! )/.test(l)) return `<span class="warn">${e}</span>`;
